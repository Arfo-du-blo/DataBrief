# DataBrief hosted MCP server: the settings of docker-compose.yml.
# Copy this file to .env (next to docker-compose.yml) and edit it. .env is never committed: it holds the tunnel token.
#   cp .env.example .env

# ---------------------------------------------------------------------------------------------------------------------------------
# Which services start
# ---------------------------------------------------------------------------------------------------------------------------------
# "tunnel" starts the Cloudflare Tunnel next to the server. Leave it empty (COMPOSE_PROFILES=) to start the server alone, behind your
# own reverse proxy (Caddy, nginx, Traefik): forward /mcp and /healthz to 127.0.0.1:8787.
COMPOSE_PROFILES=tunnel

# ---------------------------------------------------------------------------------------------------------------------------------
# Cloudflare Tunnel (only with the "tunnel" profile)
# ---------------------------------------------------------------------------------------------------------------------------------
# Make the tunnel in the Cloudflare dashboard (Zero Trust, Networks, Tunnels, Create a tunnel, Cloudflared). Add a public hostname
# (for example databrief.example.com) whose service is   HTTP   databrief-mcp:8787 . Then copy the tunnel token here.
# No Access policy, no Turnstile and no bot challenge on that hostname: the chat apps' servers cannot answer them.
TUNNEL_TOKEN=
# The cloudflared version (pinned; update it on purpose). See hub.docker.com/r/cloudflare/cloudflared/tags
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.7

# ---------------------------------------------------------------------------------------------------------------------------------
# The server
# ---------------------------------------------------------------------------------------------------------------------------------
# The public HTTPS address of the server, without a trailing slash. It gives the server's icon an absolute address.
DATABRIEF_PUBLIC_URL=https://databrief.example.com
# Behind Cloudflare the real client address is in this header, so the flood guard counts real addresses. Set it ONLY when every request
# comes through Cloudflare (the tunnel); with your own reverse proxy, set the header it adds; if the server is reachable directly, leave it empty.
# The server believes the header only when the connection comes from this machine or a private network (the tunnel, a proxy, Docker).
DATABRIEF_TRUST_PROXY_HEADER=cf-connecting-ip
# Flood guard: requests per minute per source (0 = off). Generous on purpose: Claude and ChatGPT call from shared cloud addresses.
DATABRIEF_RATE_PER_MIN=600
# Extra browser origins allowed to call /mcp, comma-separated. https://claude.ai, https://claude.com and https://chatgpt.com always are.
DATABRIEF_ALLOWED_ORIGINS=
# Request log (method names and timings only, no content, no address): on or off.
DATABRIEF_LOG=on

# ---------------------------------------------------------------------------------------------------------------------------------
# The container
# ---------------------------------------------------------------------------------------------------------------------------------
# Port published on this machine (loopback only by default). The tunnel does not use it.
DATABRIEF_MCP_BIND=127.0.0.1
DATABRIEF_MCP_PORT=8787
# Name and version of the image. "local" is what "docker compose build" makes from this repository.
DATABRIEF_MCP_IMAGE=databrief-mcp
DATABRIEF_MCP_VERSION=local
# Memory limit of the server container.
DATABRIEF_MCP_MEMORY=256m
