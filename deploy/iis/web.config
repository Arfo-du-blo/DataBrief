<?xml version="1.0" encoding="utf-8"?>
<!--
  DataBrief - IIS (Internet Information Services) configuration.
  1. Create a folder, e.g. C:\inetpub\databrief, and put databrief.html and this web.config in it
     (your settings: make databrief.html with databrief_set_default.html).
  2. IIS Manager > Sites > Add Website (or Add Application under an existing site) > physical path = that folder.
  3. HTTPS: add an https binding with your certificate in IIS Manager > Bindings.
  Passwords / access: use Windows Authentication in IIS Manager > Authentication.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="databrief.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <urlCompression doStaticCompression="true" />
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!-- frame-ancestors: sites allowed to show DataBrief in a frame (SharePoint / Teams: add their URLs) -->
        <add name="Content-Security-Policy" value="frame-ancestors 'self'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <!-- Only databrief.html is needed: hide this configuration file and everything else. -->
        <hiddenSegments>
          <add segment="web.config" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
